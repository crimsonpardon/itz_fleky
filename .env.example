# Discord Developer Portal > Bot token (keep private)
DISCORD_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE
OWNER_ID=YOUR_DISCORD_USER_ID
BOT_PREFIX=*
DB_PATH=evm_bot.db

# Pinggy TCP tunnel for SSH (no public IPv4 required)
PINGGY_HOST=free.pinggy.io
PINGGY_PORT=443

# Keep false until LXD networking, disk quotas, and firewall are verified
ENABLE_LXD_PROVISIONING=false
LXD_IMAGE=ubuntu:24.04
PORT_RANGE_START=20000
PORT_RANGE_END=30000
